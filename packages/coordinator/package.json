{
  "name": "@agent-mesh/coordinator",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @agent-mesh/shared build",
    "predev": "pnpm --filter @agent-mesh/shared build",
    "pretest": "pnpm --filter @agent-mesh/shared build",
    "build": "tsc && node -e \"require('fs').cpSync('src/public','dist/public',{recursive:true})\"",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-mesh/shared": "workspace:*",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.1.0",
    "better-sqlite3": "^11.7.0",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
{
  "name": "agent-mesh",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev": "pnpm -r run dev",
    "coordinator": "pnpm --filter @agent-mesh/coordinator dev",
    "node": "pnpm --filter @agent-mesh/node start config/mesh.example.yaml",
    "node:selfhost": "pnpm --filter @agent-mesh/node start ../../config/mesh.selfhost.yaml",
    "cli": "pnpm --filter @agent-mesh/cli start --",
    "demo": "./scripts/phase1-e2e-demo.sh",
    "plugin:slack": "pnpm --filter @agent-mesh/plugins slack"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0"
}
